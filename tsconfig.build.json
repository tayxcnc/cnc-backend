{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "generated",
    "**/*spec.ts",
    "prisma",
    "prisma.config.ts",
    // Operator scripts, run by hand with ts-node and never shipped. Excluded
    // for the same reason `prisma` is, and it is not only tidiness: TypeScript
    // roots the emit at the common ancestor of everything it compiles, so one
    // file outside `src` moves the whole build from `dist/main.js` to
    // `dist/src/main.js`, and the Dockerfile's `CMD ["node", "dist/main"]`
    // stops resolving. TAY's backend hit exactly that in its Phase 3.6.
    "scripts"
  ]
}
