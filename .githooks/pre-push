#!/bin/sh
#
# Refuse a direct push to a protected branch.
#
# main and develop change through a pull request and nothing else: work
# branches are merged into develop, and a release is develop -> main with a
# merge commit. A direct push bypasses the founder's review, which is the only
# gate there is (branch protection is unavailable on these private repos).
#
# Tags are deliberately allowed. A release tag is pushed straight to the remote
# by design, and `git push origin v1.0.0` sends refs/tags/... which none
# of the cases below match. Blocking a tag would make the release process
# impossible and send someone looking for --no-verify, which would then be
# habit by the time it mattered.
#
# Installed through core.hooksPath, beside the gitleaks pre-commit hook:
#   git config core.hooksPath .githooks

while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
	refs/heads/main)
		echo "BLOCKED: direct push to main."
		echo "main changes only through a pull request from develop."
		exit 1
		;;
	refs/heads/develop)
		echo "BLOCKED: direct push to develop."
		echo "develop changes only through a pull request from a feature branch."
		exit 1
		;;
	esac
done

exit 0
