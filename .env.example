# CNC backend environment. Copy to .env and fill in an editor; never commit
# .env and never print it.
#
# Every name is CNC_-prefixed except PORT and NODE_ENV. CNC shares a GCP
# project with TAY, and the prefix is what stops CNC from mounting or reading
# a TAY secret. The service refuses to boot if any TAY_ variable is present,
# so do not copy values from TAY's .env. See "Configuration" in
# docs/conventions.md.
#
# "Secret on deployed environments" means the value is mounted from Secret
# Manager with --set-secrets, created with printf, never --set-env-vars.

# Build mode. "production" on staging too, because it is a build flag; which
# deployment this is comes from CNC_ENV.
NODE_ENV=development

# The port the API listens on. Set by Cloud Run when deployed.
PORT=3000

# Which deployment this is: local, staging or production. The deployed boot
# rules (sweep token, JWT secret length, non-empty CORS list) and the
# production rules key on this, not on NODE_ENV.
CNC_ENV=local

# Database URL. Locally Homebrew Postgres on 5432, database cnc_db, role
# cnc_app (password from openssl rand -hex 24). Always write the host and
# port: the seeds' safety check treats a URL without them as not local. Point it at cnc_test while
# running the e2e suite. Port 5433 is the Cloud SQL proxy and counts as remote.
# Secret on deployed environments, in the Unix socket form.
CNC_DB_URL=postgresql://USER:PASSWORD@localhost:5432/cnc_db

# Signs access tokens. Generate with: openssl rand -hex 32
# The service refuses to boot on this placeholder or on a value under 32
# characters, locally too. Secret on deployed environments.
CNC_JWT_SECRET=CHANGE_ME

# Every origin allowed to make a credentialed request, comma separated, full
# origins with no path. Locally the CNC site's dev server. Empty blocks every
# browser while health checks still pass, so deployed services refuse to boot
# without it. Secret on deployed environments.
CNC_CORS_ORIGINS=http://localhost:3001

# The CNC website's base URL, including the /cnc base path and with no
# trailing slash. Used for links in emails and payment callbacks.
# Secret on deployed environments; https in production.
CNC_WEB_URL=http://localhost:3001/cnc

# The staff app's origin. Optional locally. Secret on deployed environments.
CNC_STAFF_URL=http://localhost:3002

# Where enquiries are forwarded: CNC's own inbox. Optional locally; use an
# inbox of your own so a test enquiry never reaches CNC. Required in
# production. Secret on deployed environments.
CNC_CONTACT_EMAIL=enquiries@example.com

# Shared secret Cloud Scheduler sends to the sweep routes. Generate with:
# openssl rand -hex 32. Optional locally (no sweeps run without it); required
# on staging and production. Secret on deployed environments.
CNC_SWEEP_TOKEN=CHANGE_ME

# CNC's own Paystack merchant account, never TAY's. A test key (sk_test_)
# on staging, a live key (sk_live_) in production only; staging refuses a
# live key. Secret on deployed environments. Locally (CNC_ENV=local) no
# call ever reaches Paystack (LocalPaystackClient): never put a real key
# here. While this is the placeholder a local checkout answers 503, so for
# a local walk put any made-up value, for example sk_test_local_walk; it
# only signs the fake webhooks you send yourself.
CNC_PAYSTACK_SECRET_KEY=PLACEHOLDER_NOT_SET

# CNC's own Resend API key, never TAY's. Locally (CNC_ENV=local) no mail is
# ever sent, whatever this holds: messages are written to the server log
# instead, so a sign-in code can be read there. On staging and production,
# while this or CNC_MAIL_FROM is unset or a placeholder, emails wait in the
# queue for the messages sweep and no request fails. Secret on deployed
# environments.
CNC_RESEND_API_KEY=PLACEHOLDER_NOT_SET

# The sender address for CNC's email, on a domain verified with Resend
# (Q19: CNC <cnc@tayxcnc.com>). Read as for CNC_RESEND_API_KEY. Secret on
# deployed environments.
CNC_MAIL_FROM=PLACEHOLDER_NOT_SET

# The private Cloud Storage bucket for CNC's images. Not a secret: passed with
# --set-env-vars (staging: tayxcnc-cnc-staging-media). Read on the first
# staff or menu photo upload, never at boot. A local upload also needs
# `gcloud auth application-default login` and a bucket you may write to; the
# e2e suite uses an in-memory fake and needs neither.
CNC_GCS_BUCKET=PLACEHOLDER_NOT_SET

# Local only: the first Owner account, created once by `npm run db:seed:owner`.
# The running application never reads these, and none belongs in a deployed
# environment. The seed refuses the placeholder password below and anything
# under 8 characters; the Owner is asked for a new password at first sign-in.
# The name is optional (default "Owner"); the Owner can change it in the app.
CNC_SEED_OWNER_EMAIL=owner@example.com
CNC_SEED_OWNER_PASSWORD=choose_a_real_password_before_running_the_seed
CNC_SEED_OWNER_NAME=

# Seeds refuse any database but a local one (a loopback host on any port but
# the Cloud SQL proxy's 5433). Each writing seed has its own override, and
# only exactly "true" permits a remote run. Set one in the shell for the one
# run that needs it, never here.
# CNC_SEED_DATA_ALLOW_REMOTE=true     (npm run db:seed)
# CNC_SEED_OWNER_ALLOW_REMOTE=true    (npm run db:seed:owner)
