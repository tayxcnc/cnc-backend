// CNC schema — the one schema in this repository.
//
// There is no `url` here. Prisma 7 rejects it in the schema: the CLI reads the
// database URL from `prisma.config.ts` and the running service passes a driver
// adapter to PrismaClient in CncPrismaService. CNC_DB_URL is the variable's
// name in both places.

datasource db {
  provider = "postgresql"
}

// `prisma-client-js`, kept deliberately. Prisma 7 deprecates it in favour of
// `prisma-client`, which emits TypeScript instead of a prebuilt JavaScript
// bundle. A .ts file under generated/ pulls that directory into the build and
// moves every entry point from dist/ to dist/src/, which is not where the
// image runs it. That move is its own card at a later boundary; the
// deprecated generator compiles and runs cleanly under 7.10.0.
//
// The output is a path of its own, imported by that path everywhere
// (`generated/cnc-client`), never through `@prisma/client`.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/cnc-client"
}

// ---------------------------------------------------------------------------
// Conventions
//
// Money   Int, in kobo. Never Float, never Decimal-as-string. ₦20,000 is
//         2000000. Field names carry the `Kobo` suffix so a bare number is
//         never mistaken for naira at a call site.
// Time    DateTime is UTC everywhere. Raw SQL writes `now() AT TIME ZONE
//         'UTC'`, never a bare `now()`, so a session timezone cannot shift it.
// Dates   `@db.Date` marks every business date (the day an order belongs to,
//         the day a reservation is for). A business date must not carry a
//         time or shift across a timezone boundary; it is computed in
//         Africa/Lagos by src/common/wat.ts and stored at UTC midnight.
// Clock   Wall-clock times of day are String "HH:mm" in 24h form. They are a
//         schedule, not an instant, and must not drift with UTC conversion.
// Keys    Every model: id String @id @default(cuid()), createdAt, updatedAt.
//         Human numbers (`CNCR-000001`, `CNC-S001`…) are separate columns
//         drawn from one Postgres sequence per prefix (nextSequenceCode),
//         never derived from the id.
// Version Every row two devices can edit carries `version Int @default(0)`,
//         and a write naming a stale version is a 409 (plan A8).
// Names   camelCase fields with no underscores: uniqueViolationTargets
//         recovers a P2002's fields by splitting the constraint name on `_`.
//
// Nigerian phone validation lives in the DTO layer, not here:
//   /^(\+234|0)[789][01]\d{8}$/
// A phone that is stored to be compared (Customer.phone) is written in one
// form, `0` plus 10 digits (plan §4.2), by canonicalNigerianPhone, and a
// CHECK in the migration refuses any other spelling.
//
// Raw SQL in the migrations adds what Prisma cannot express: CHECK
// constraints, the case-insensitive StockItem name index, the append-only
// trigger on AuditLog and the human-number sequences. Each is described on
// its model below and in the migration that creates it.
//
// Deletion policy — every relation states onDelete explicitly; no Prisma
// default is accepted silently.
//   Staff       required attribution restricts; optional attribution nulls.
//               A record that cannot exist without an actor blocks the delete;
//               a record that merely records who touched it survives without.
//   Ledgers     Payments, stock movements and the audit log restrict their
//               parents. History is not deletable. An order line restricts
//               its menu item for the same reason — the price it captured
//               must outlive the item.
//   Children    A row meaningless without its parent (an order's lines)
//               cascades from that parent, and says so.
//   onUpdate    Left at Prisma's default CASCADE on every foreign key. Every
//               key references an immutable cuid() primary key that no code
//               path updates, so the action is unreachable. Considered and
//               left alone — not an oversight.
// ---------------------------------------------------------------------------

// ============================== ENUMS ======================================
//
// Enums travel as UPPER_SNAKE (plan A5); each frontend maps them to its own
// labels in one adapter.

enum Department {
  RESTAURANT
  BAR
}

enum MenuCategoryKind {
  FOOD
  DRINKS
  SLUSH
}

enum TableKind {
  BOOTH
  DINING
  WINDOW
  COUNTER
  SOFA
  TWO
}

/// The receipt printer's paper. The staff app's labels are `80mm`, `58mm`
/// and `A4`; an enum value cannot start with a digit.
enum PrinterWidth {
  MM80
  MM58
  A4
}

/// One role per person, as the staff app has (plan §4.2).
enum StaffRole {
  OWNER
  MANAGER
  RECEPTION
  CASHIER
  WAITER
  BARTENDER
  KITCHEN
  STOREKEEPER
}

enum AddressZone {
  JOS
  PLATEAU
}

/// How a message reaches a customer: a customer's preferred channel, and the
/// channel an outbound message is sent on.
enum ContactChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  SIGN_IN
  CHANGE_EMAIL
}

/// Which realm a refresh token belongs to (TAY's model).
enum SubjectType {
  CUSTOMER
  STAFF
}

/// Replaces the staff demo's `bar-` id prefix (D45).
enum StockKind {
  KITCHEN
  BAR
}

enum AuditActorKind {
  STAFF
  CUSTOMER
  SYSTEM
}

enum CustomerNotificationKind {
  ORDER
  BOOKING
  ACCOUNT
}

enum OutboundMessageStatus {
  PENDING
  SENT
  FAILED
}

enum EnquiryKind {
  CONTACT
  GROUP
}

enum EnquiryStatus {
  NEW
  HANDLED
}

/// Where an order came from: the till, or the website and app (plan §4.3).
enum OrderChannel {
  POS
  WEB
}

/// The staff app's order states: Open, Payment, Settled, Cancelled.
enum OrderStatus {
  OPEN
  PAYMENT
  SETTLED
  CANCELLED
}

/// Cash, Card and Transfer at the till; Online for a Paystack payment.
enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ONLINE
}

/// How a web order leaves the kitchen. Carried by a web docket so a
/// pre-order prints as one (plan §4.3); the checkout uses it from C7.
enum Fulfilment {
  DELIVERY
  PICKUP
}

/// Where stock is held: the store counts packs, the kitchen and the bar
/// count units (plan §7.6).
enum StockLocation {
  STORE
  KITCHEN
  BAR
}

/// Why a stock balance moved: the 15 types the staff app writes
/// (`staff/lib/domain.ts`, every `move()` call, with "Issue to Kitchen" and
/// "Issue to Bar" as two), plus `WEB_SALE` for a paid web order's drinks
/// (plan §4.6, §7.4). The demo's seeded "Opening balance" is not a type:
/// opening balances are entered by stock count (Q11, the C4 gate). Its dead
/// "Unit conversion adjustment" label is dropped (D40).
enum StockMovementType {
  ISSUE_TO_KITCHEN
  ISSUE_TO_BAR
  STOCK_RECEIVED
  STOCK_COUNT
  ADMIN_ADJUSTMENT
  KITCHEN_ENTRY
  KITCHEN_CORRECTION
  BAR_SALE
  SETTLEMENT_REVERSAL
  PURCHASE_RECEIPT
  PURCHASE_CORRECTION
  WASTE
  WASTE_CORRECTION_RETURN
  WASTE_CORRECTION_DEDUCTION
  WASTE_APPROVAL_CORRECTION
  WEB_SALE
}

/// A booking's lifecycle (D22). Availability is derived from it, never
/// stored: see plan §7.5.
enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Who took a booking. All three run the one command (plan §7.5).
enum ReservationSource {
  WEB
  APP
  RECEPTION
}

/// A table's allocation: guests seated, or locked with a reason.
enum TableSessionStatus {
  OCCUPIED
  LOCKED
}

// ============================== REFERENCE DATA (§4.1) ======================

/// The one settings row: VAT, service, fees, approval limits, the printer,
/// the bell's switches and the ordering times (plan §4.1).
///
/// **One row only.** `singleton` is unique and a CHECK in the migration holds
/// it true, so a second row cannot be inserted by any path. Reads take the
/// row with `findUniqueOrThrow({ where: { singleton: true } })`.
///
/// The defaults are the values in the code today, which Q7 asks the founder
/// to confirm; the seed (C3-2) writes the row. Which keys only the Owner may
/// change is a service rule (plan §6.2), not a column property.
///
/// Rates are basis points (750 is 7.5%). Times of day are minutes after
/// midnight, WAT: 1380 is 23:00 and 1410 is 23:30.
model Settings {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  singleton Boolean @unique @default(true)

  vatBps      Int @default(750)
  serviceBps  Int @default(0)
  depositKobo Int @default(0)

  /// The Free Table Reminder, 15 to 1440 (a CHECK holds the range).
  freeTableReminderMinutes Int @default(180)

  deliveryJosKobo     Int @default(500000)
  deliveryOutsideKobo Int @default(1000000)

  /// The Owner Approval Limit, per decision.
  approvalLimitKobo Int     @default(5000000)
  /// The Daily Approval Limit, per manager per day. Approvals are recorded in
  /// the ledger even while it is off (D36).
  dailyLimitOn      Boolean @default(true)
  dailyLimitKobo    Int     @default(15000000)

  printerWidth PrinterWidth @default(MM80)

  alertLowStock  Boolean @default(true)
  alertApprovals Boolean @default(true)
  alertUnsettled Boolean @default(true)
  alertArrivals  Boolean @default(true)

  lastArrivalMinutes   Int @default(1380)
  lastOrderSlotMinutes Int @default(1410)
  slotStepMinutes      Int @default(30)
  leadPickupMinutes    Int @default(60)
  leadJosMinutes       Int @default(90)
  leadOutsideMinutes   Int @default(120)

  version Int @default(0)
}

/// CNC's business details: one source for the website, receipts and the
/// entrance (D28). One row, held by `singleton` as on Settings.
///
/// `phone` is stored as digits (`08022188797`); the site formats it.
/// `addressLine` carries no country; the site appends ", Nigeria".
/// `socialLinks` is an object keyed by network, empty until supplied.
model Business {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  singleton Boolean @unique @default(true)

  name         String
  addressLine  String
  addressLines String[]
  phone        String
  email        String
  registration String
  /// Coordinates for the map pin, not money: Float is right here.
  mapLat       Float?
  mapLng       Float?
  socialLinks  Json     @default("{}")

  version Int @default(0)
}

/// The week's opening hours: TAY's model and response shape
/// (`GET /opening-hours`), keyed by the day, as TAY's is (D26).
///
/// The migration that creates the table seeds 08:00 to midnight (480 to 1440)
/// every day with `ON CONFLICT DO NOTHING`, so applying it again never
/// overwrites a week the Owner has saved. Two CHECKs, copied from TAY, refuse
/// an impossible day.
model OpeningHoursDay {
  /// 0 = Sunday … 6 = Saturday, JavaScript's `getDay()`.
  dayOfWeek Int      @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isClosed        Boolean
  /// Null exactly when `isClosed`.
  opensAtMinutes  Int?
  /// Null exactly when `isClosed`. 1440 is midnight at the end of the day.
  closesAtMinutes Int?
}

/// A room: Dining and Lounge (D25). Both labels are stored, because the site
/// says "Dining" where the staff app says "Diner".
model Venue {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug          String @unique
  customerTitle String
  staffName     String
  /// The party size from which the website sends a booking to the team as a
  /// group enquiry: 4 in Dining, 5 in the Lounge.
  bigParty      Int
  sort          Int

  tables    DiningTable[]
  enquiries Enquiry[]
}

/// A table. Codes repeat across rooms (TS1 to TS3 exist in both), so the code
/// is unique per venue only (D25). Coordinates, the floor-plan drawing and
/// descriptive copy stay in the frontends (D61).
model DiningTable {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venueId  String
  code     String
  name     String
  kind     TableKind
  capacity Int
  active   Boolean   @default(true)

  /// Restrict: a room with tables is not deleted.
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Restrict)

  orders        Order[]
  reservations  Reservation[]
  tableSessions TableSession[]

  @@unique([venueId, code])
}

/// A customer-facing menu category: the 12 ids the website uses (`breakfast`,
/// `the-grill`, `slush`…).
model MenuCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug  String           @unique
  title String
  note  String?
  kind  MenuCategoryKind
  sort  Int

  staffCategories StaffCategory[]
  menuItems       MenuItem[]
}

/// What staff choose when they add a dish ("Pizza", "Tea Corner (Hot)"),
/// mapped to the customer category it belongs to. Seeded from the 25 entries
/// in `cnc-frontend/docs/staff-id-map.json`.
model StaffCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String     @unique
  department     Department
  menuCategoryId String

  /// Restrict: a customer category in use is not deleted.
  menuCategory MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Restrict)
  menuItems    MenuItem[]
}

/// A dish or a drink (plan §4.1).
///
/// `slug` is permanent and never reused, so a link or a cart line that names
/// it keeps meaning the same dish. `legacyStaffId` (`food-12`, `bar-3`) is the
/// staff demo's id, kept for the one-time import; items added in the app
/// have none. A price change applies to new order lines only: each line
/// snapshots the price it was sold at.
///
/// `active` is the staff app's "Available for Sale"; `showOnline` decides
/// whether the website lists it. `choiceLabel` and `choiceOptions` carry the
/// 11 dishes that ask the guest to choose (an empty list means no choice).
/// `photo` is a `gs://` URI, never a URL a browser can load (A17).
///
/// A Bar item has exactly one paired Bar StockItem (`stockItem`), created in
/// the same transaction as the item (plan §5.4, Menu & Prices).
model MenuItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug            String     @unique
  legacyStaffId   String?    @unique
  department      Department
  staffCategoryId String
  menuCategoryId  String
  groupLabel      String?
  name            String
  description     String     @default("")
  /// Never negative (a CHECK in the migration).
  priceKobo       Int
  signature       Boolean    @default(false)
  active          Boolean    @default(true)
  showOnline      Boolean    @default(true)
  photo           String?
  photoAlt        String?
  choiceLabel     String?
  choiceOptions   String[]   @default([])
  sort            Int        @default(0)

  version Int @default(0)

  /// Restrict on both categories: a category with dishes is not deleted.
  staffCategory   StaffCategory    @relation(fields: [staffCategoryId], references: [id], onDelete: Restrict)
  menuCategory    MenuCategory     @relation(fields: [menuCategoryId], references: [id], onDelete: Restrict)
  stockItem       StockItem?
  orderLines      OrderLine[]
  kitchenMappings KitchenMapping[]

  @@index([menuCategoryId, sort])
  @@index([department])
}

// ============================== PEOPLE AND SIGN-IN (§4.2) ==================

/// A member of CNC's staff. One role per person, as the staff app has.
///
/// `staffNo` (`CNC-S001`) comes from `staff_no_seq`. `email` is unique and
/// stored lower case (a CHECK refuses anything else), so two spellings of one
/// address cannot be two accounts. `passwordHash` is argon2id (A14) and
/// `mustChangePassword` forces a change at first sign-in.
///
/// **`qrToken` is a credential, never a field.** 32 random bytes, base64url;
/// the QR payload is `CNC-ID:<staffNo>:<token>`. No response carries it at
/// any depth: the person sees it only as a rendered image. With
/// `passwordHash`, it is on the list of values no response, log or audit row
/// may contain.
///
/// Never deleted: an account is deactivated (`isActive`). Every relation
/// that records a staff member's act restricts the delete.
model Staff {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffNo            String    @unique
  name               String
  email              String    @unique
  role               StaffRole
  isActive           Boolean   @default(true)
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  /// A `gs://` URI, or null (A17).
  photo              String?
  qrToken            String    @unique
  qrRegeneratedAt    DateTime?
  joinedOn           DateTime  @db.Date
  /// The manager overview's layout, saved per person (today in the
  /// browser's localStorage). Null until first saved.
  overviewPrefs      Json?

  version Int @default(0)

  passwordResetTokens PasswordResetToken[]
  auditEntries        AuditLog[]
  approvals           ApprovalLedger[]
  ordersOpened        Order[]              @relation("OrderOpenedBy")
  dockets             Docket[]
  payments            Payment[]
  cashCounts          CashCount[]
  kitchenEntries      KitchenEntry[]
  kitchenDaysClosed   KitchenDayClosed[]
  tableSessionsOpened TableSession[]       @relation("TableSessionOpenedBy")
  tableSessionsClosed TableSession[]       @relation("TableSessionClosedBy")
  stockMovements      StockMovement[]

  @@index([role, isActive])
}

/// A website and app customer (plan §4.2). The models exist from C3 so the
/// audit log and customer notifications can name a customer; the routes that
/// create and sign in customers arrive in C6.
///
/// `memberNo` (`CNC-000001`) comes from `customer_member_no_seq` and replaces
/// the number the account screen derives from the id today. `email` and
/// `phone` are each unique and nullable: a customer may have either. Email is
/// stored lower case; phone is stored as `0` plus 10 digits (a CHECK refuses
/// `+234…` and every other spelling), so one number cannot be two customers.
///
/// `prefOffers` is stored false and refused as true until the founder
/// enables offers. Never deleted: Q36's default anonymises instead.
model Customer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberNo             String         @unique
  name                 String
  email                String?        @unique
  phone                String?        @unique
  emailVerifiedAt      DateTime?
  phoneVerifiedAt      DateTime?
  addressZone          AddressZone?
  addressStreet        String?
  addressArea          String?
  addressTown          String?
  addressLandmark      String?
  prefOrderUpdates     Boolean        @default(true)
  prefBookingReminders Boolean        @default(true)
  prefOffers           Boolean        @default(false)
  prefChannel          ContactChannel @default(EMAIL)
  /// A `gs://` URI, or null (A17).
  photo                String?
  /// Notifications created after this instant are unread.
  notificationsReadAt  DateTime?

  otpCodes      OtpCode[]
  notifications CustomerNotification[]
  auditEntries  AuditLog[]
  orders        Order[]
  reservations  Reservation[]
}

/// A one-time sign-in or email-change code (A15). The code is 6 digits and
/// is never stored or returned: `codeHash` is `sha256(code)` as hex, so a
/// database read never yields a usable code. The attempt limit and the
/// 10-minute expiry are the defence against guessing, not the hash.
///
/// `contact` is the normalised email (or phone) the code was sent to;
/// `customerId` is set when the contact already belongs to a customer, and
/// nulls if that customer is ever removed (optional attribution nulls).
model OtpCode {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purpose     OtpPurpose
  contact     String
  customerId  String?
  codeHash    String
  attempts    Int        @default(0)
  expiresAt   DateTime
  resendAfter DateTime
  consumedAt  DateTime?
  ipAddress   String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([contact, purpose, createdAt])
  @@index([ipAddress, createdAt])
  @@index([expiresAt])
}

/// Refresh tokens for both realms: TAY's model (plan §4.2).
///
/// `subjectId` is deliberately not a foreign key: one table serves customers
/// and staff, and a column pointing at one of two tables by a discriminator
/// cannot be expressed cleanly. Revocation is a `subjectId` + `subjectType`
/// lookup, and verification re-reads the subject, so an orphaned row is
/// unusable anyway.
///
/// `tokenHash` is `sha256(rawToken)` as hex, not argon2: the raw token is 256
/// random bits with nothing to brute-force, and a deterministic digest is
/// itself the lookup key. Single-use and rotated on every refresh.
///
/// `rotated` is true only on a row spent by a refresh, never on one revoked
/// by a sign-out, a password change or an account change. A rotated token
/// presented again is a copy being replayed (reuse detection,
/// `CncTokenService.redeemRefreshToken`); a signed-out one is just stale.
model RefreshToken {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tokenHash   String      @unique
  subjectId   String
  subjectType SubjectType
  expiresAt   DateTime
  revokedAt   DateTime?
  rotated     Boolean     @default(false)

  @@index([subjectId, subjectType])
  @@index([expiresAt])
}

/// A single-use staff password reset (TAY's model, staff only). The raw
/// token is returned once and never stored; `tokenHash` is its SHA-256.
/// `consumedAt` rather than `revokedAt`, because a reset is spent.
///
/// Cascade: a reset token is meaningless without its staff member, and staff
/// are never deleted in any case.
model PasswordResetToken {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tokenHash  String    @unique
  staffId    String
  expiresAt  DateTime
  consumedAt DateTime?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
}

// ============================== STOCK (§4.6, the core) =====================

/// A stock item (plan §4.6). The item exists from C3, because the seed
/// pairs every Bar menu item with one and `menu.save` creates one for each
/// new Bar item; balances, movements and the kitchen comparison rules
/// arrive with the stock core in C4.
///
/// `name` is unique **case-insensitively**: the staff app refuses "Rice"
/// beside "rice" ("This stock item already exists."). Prisma cannot express
/// an index on `lower(name)`, so the migration creates it as
/// `StockItem_name_key`, which `uniqueViolationTargets` reads as `["name"]`.
///
/// `unit` is "Used As", `pack` is "Bought As", `factor` is "How Many in One"
/// and `minimum` is the reorder level in usage units. A CHECK holds `factor`
/// above zero and `minimum` at zero or above.
///
/// `kind` replaces the demo's `bar-` id prefix (D45). **A Bar item is
/// exactly the paired stock of one Bar menu item, and a Kitchen item has
/// none**: a CHECK ties `kind = 'BAR'` to `menuItemId IS NOT NULL`, and
/// `menuItemId` is unique, so no menu item has two. Restrict: a menu item
/// with stock is never deleted (it is deactivated).
model StockItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name       String
  kind       StockKind
  unit       String
  pack       String
  factor     Int
  minimum    Int
  menuItemId String?   @unique
  active     Boolean   @default(true)

  version Int @default(0)

  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  balances        StockBalance[]
  movements       StockMovement[]
  kitchenMappings KitchenMapping[]

  @@index([kind])
}

/// One item's quantity at one location (plan §4.6): whole packs at the
/// Store, whole units in the Kitchen and at the Bar.
///
/// **Only `StockLedgerService.move` writes it**, in the same transaction as
/// the `StockMovement` that explains the change, so the balance is always
/// the running sum of the movements (checked in the e2e suite). A decrement
/// is one conditional `UPDATE … WHERE qty + delta >= 0`: no read, so no gap
/// in which two writers both see enough stock (TAY's `StockService`).
///
/// A missing row is a zero balance: rows are created on the first movement
/// at that location, so the 87 seeded Bar items start with none (Q11).
///
/// There is no `qty >= 0` CHECK, deliberately: a paid web order's drinks are
/// deducted without refusing and may take the Bar below zero (plan §7.4;
/// the money is already taken). Every other movement refuses to go below
/// zero in the service. Which locations an item may hold (a Kitchen item
/// never at the Bar, a Bar item never in the Kitchen) is the service's rule
/// too. Restrict: a stock item with a balance is never deleted.
model StockBalance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockItemId String
  location    StockLocation
  qty         Int           @default(0)

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([stockItemId, location])
  @@index([location])
}

/// One change to one balance, and why (plan §4.6). The movements are the
/// truth; `StockBalance` is their running sum.
///
/// **Append-only**, by trigger as `AuditLog` is: a movement edited or
/// deleted would leave a balance no history explains. A correction is a new
/// movement. There is no `updatedAt`, because a row never changes.
///
/// `qty` is signed and whole, never zero (a CHECK): packs at the Store,
/// units elsewhere. `ref` is what the screens show beside it, as the staff
/// app writes it: an order number, a `KOT-` ref, a request or purchase
/// number, or a direct issue's note. `staffId` is null only for a movement
/// nobody on the staff made (a paid web order's drinks). Both relations
/// restrict: a foreign key that set null would be an UPDATE the trigger
/// refuses.
model StockMovement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  stockItemId String
  location    StockLocation
  qty         Int
  type        StockMovementType
  ref         String
  staffId     String?

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  staff     Staff?    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([stockItemId, location, createdAt])
  @@index([location, createdAt])
  @@index([ref])
}

/// A comparison rule for the kitchen crosscheck (plan §4.3, §7.10): the
/// Kitchen portions one Restaurant menu item is expected to use. Settings →
/// Kitchen Comparison Rules; `mapping.save` replaces an item's whole set.
///
/// The rules never fill in a kitchen entry or move stock. That the menu
/// item is a Restaurant item and the stock item a Kitchen item is the
/// service's rule ("Choose a food menu item.", "Choose a kitchen portion.");
/// a CHECK holds `qty` above zero. Cascade from the menu item, whose rules
/// these are; restrict the stock item, which a rule names.
model KitchenMapping {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItemId  String
  stockItemId String
  qty         Int

  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, stockItemId])
  @@index([stockItemId])
}

// ============================== TILL, KITCHEN AND PAYMENTS (§4.3) ==========

/// A bill (plan §4.3, §7.1–§7.3).
///
/// `number` is `CNCR-000001` (Restaurant) or `CNCB-000001` (Bar), drawn from
/// one sequence per department that every channel shares (D29). A web order
/// is one `CNCR` order whose lines carry their own department (D30).
///
/// `vatBps` and `serviceBps` are snapshotted from Settings when the order
/// is opened, so a rate change applies to new bills only. `revision` is the
/// last docket revision written (0: never confirmed); the confirmed lines
/// are the latest docket's. `depositKobo` is the reservation credit used at
/// settlement (D38: always 0 until a route sets a deposit).
///
/// A CHECK ties `settledAt` to `SETTLED`: a reversal clears both. Never
/// deleted: a bill is cancelled.
model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  number        String       @unique
  department    Department
  channel       OrderChannel @default(POS)
  tableId       String?
  label         String
  guest         String       @default("")
  businessDate  DateTime     @db.Date
  status        OrderStatus  @default(OPEN)
  revision      Int          @default(0)
  vatBps        Int
  serviceBps    Int
  discountKobo  Int          @default(0)
  depositKobo   Int          @default(0)
  reservationId String?
  notes         String       @default("")
  settledAt     DateTime?
  /// Null for a web order, which nobody on the staff opened.
  openedById    String?
  customerId    String?

  version Int @default(0)

  table       DiningTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  openedBy    Staff?       @relation("OrderOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  lines          OrderLine[]
  dockets        Docket[]
  payments       Payment[]
  kitchenEntries KitchenEntry[]

  @@index([businessDate, department])
  @@index([status, department])
  @@index([tableId, status])
  @@index([customerId])
}

/// One line of a bill (plan §4.3). A line is an item plus its option, so
/// the same dish with two choices is two lines; `option` is `""` when the
/// dish has none (an empty string rather than null, so the unique index
/// treats every option-less line of a dish as the same line).
///
/// `unitPriceKobo` and `name` are snapshots: a price change applies to new
/// lines only. `department` is the item's, so a web order's drinks are told
/// from its food. A CHECK holds `qty` to 1–999 and the price at zero or
/// above. An unconfirmed line set to zero is removed; what was sent to the
/// kitchen lives on in its docket. Cascade from the order; restrict the
/// menu item, whose sale it records.
model OrderLine {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderId       String
  menuItemId    String
  name          String
  option        String     @default("")
  qty           Int
  unitPriceKobo Int
  department    Department

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, menuItemId, option])
  @@index([menuItemId])
}

/// A kitchen docket revision (plan §4.3, §7.1): `KOT-<order number>`, the
/// full list of the order's confirmed **Restaurant** lines at that revision.
/// Revisions are immutable; a confirm with no change reprints the latest
/// one. A cancellation docket has no items.
///
/// `items` is a JSON snapshot (`[{menuItemId, name, option, qty,
/// unitPriceKobo}]`). The web fields (`channel`, `fulfilment`,
/// `scheduledFor`) let a pre-order print as one. `staffId` is null for a
/// web docket. Restrict both ways: a docket is history.
model Docket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ref          String
  orderId      String
  revision     Int
  businessDate DateTime     @db.Date
  items        Json
  notes        String       @default("")
  staffId      String?
  channel      OrderChannel
  fulfilment   Fulfilment?
  scheduledFor DateTime?

  order Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([orderId, revision])
  @@index([ref, revision])
  @@index([businessDate, channel])
}

/// Money received against a bill, or returned (plan §4.3, §7.3).
///
/// `number` is `PAY-000001`, shown in Daily Transfers. `amountKobo` is never
/// zero and is negative for a refund. Split payments are several rows; a
/// part payment is flagged `part`. A reversal flags the row (`reversed`,
/// `reversedAt`, held together by a CHECK) and never deletes it.
/// `providerRef` is Paystack's reference, unique when set; the card is only
/// ever its brand and last four digits (never a card number, plan §8.5).
/// Restrict both ways: a payment is a ledger row.
model Payment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  number       String        @unique
  orderId      String
  method       PaymentMethod
  amountKobo   Int
  sender       String        @default("")
  reference    String        @default("")
  part         Boolean       @default(false)
  reversed     Boolean       @default(false)
  reversedAt   DateTime?
  staffId      String?
  providerRef  String?       @unique
  cardBrand    String?
  cardLast4    String?
  businessDate DateTime      @db.Date

  order Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([businessDate, method])
}

/// A cashier's drawer count for a business date (plan §4.3, §7.3):
/// `CASH-000001`. `expectedKobo` is the date's non-reversed cash payments;
/// several counts per date are allowed. A CHECK holds the difference to
/// counted − expected. Restrict: a count is history.
model CashCount {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  number         String   @unique
  businessDate   DateTime @db.Date
  staffId        String
  expectedKobo   Int
  countedKobo    Int
  differenceKobo Int

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([businessDate])
}

/// The kitchen's own record of the portions used for a docket (plan §4.3),
/// entered from the paper docket's number and compared with the comparison
/// rules in the crosscheck. One entry per docket ref; the date, order and
/// revision come from the docket. `lines` is `[{stockItemId, qty}]`.
/// `staffId` is whoever saved it last. Restrict both ways.
model KitchenEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  docketRef    String   @unique
  orderId      String
  revision     Int
  businessDate DateTime @db.Date
  lines        Json
  staffId      String

  version Int @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([orderId])
}

/// A kitchen day closed (`kitchen.close`): later saves for that date are
/// manager corrections with a reason. Once per date (unique).
model KitchenDayClosed {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  businessDate DateTime @unique @db.Date
  closedById   String

  closedBy Staff @relation(fields: [closedById], references: [id], onDelete: Restrict)
}

// ============================== TABLES AND RESERVATIONS (§4.5) =============

/// A table booking from the website, the app or Reception: one command for
/// all three (plan §4.5, §7.5).
///
/// **One active booking per table per date, for every channel**: a partial
/// unique index on (`tableId`, `businessDate`) where the status is
/// `CONFIRMED` or `CHECKED_IN`, written by hand in the migration as
/// `Reservation_tableId_businessDate_key`, so two bookings racing for one
/// table cannot both commit and the clash reads as a P2002 on those fields
/// (D21). A booking holds its table for the whole date (D20).
///
/// `number` is `RSV-000001`. `startMinutes` is the arrival time in minutes
/// after midnight, WAT. `phone` is stored normalised. `depositKobo` and
/// `depositUsedKobo` stay 0 until a route sets a deposit (D38). How a
/// Reception booking links to a customer is Q35. Never deleted: cancelled.
model Reservation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  number          String            @unique
  tableId         String
  customerId      String?
  name            String
  phone           String
  email           String            @default("")
  businessDate    DateTime          @db.Date
  startMinutes    Int
  party           Int
  status          ReservationStatus @default(CONFIRMED)
  source          ReservationSource
  note            String            @default("")
  depositKobo     Int               @default(0)
  depositUsedKobo Int               @default(0)
  cancelledAt     DateTime?
  reminderSentAt  DateTime?

  version Int @default(0)

  table    DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  orders        Order[]
  tableSessions TableSession[]

  @@index([businessDate, status])
  @@index([tableId, businessDate])
  @@index([customerId])
}

/// A table's allocation (plan §4.5): guests seated (`OCCUPIED`) or the
/// table locked with a reason (`LOCKED`), from `since` until `endedAt`.
///
/// **One open allocation per table**: a partial unique index on `tableId`
/// where `endedAt IS NULL`, written by hand as `TableSession_tableId_key`,
/// so two allocations racing for one table cannot both commit. A release
/// ends the session (`endedAt`, `closedById`) and keeps it as history.
/// `note` is the lock reason. Restrict the table and the staff who opened
/// it; the closer nulls (optional attribution).
model TableSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableId       String
  status        TableSessionStatus
  guest         String             @default("")
  party         Int                @default(0)
  note          String             @default("")
  since         DateTime           @default(now())
  endedAt       DateTime?
  reservationId String?
  openedById    String
  closedById    String?

  version Int @default(0)

  table       DiningTable  @relation(fields: [tableId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  openedBy    Staff        @relation("TableSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy    Staff?       @relation("TableSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([tableId, endedAt])
  @@index([endedAt, status])
}

// ============================== MONEY CONTROLS (§4.3, the ledger only) =====

/// The Daily Approval Limit's ledger (plan §4.3, §6.2): one row per money
/// decision a manager made that counts toward their day, written by
/// `MoneyControlService.withinLimit` in the command's own transaction.
///
/// **The sum is taken and the row inserted under
/// `pg_advisory_xact_lock` on the manager and the business date**, so two
/// approvals racing past the limit cannot both see the old total. Rows are
/// written while the daily limit is switched off too (D36), so switching it
/// back on counts the day's decisions already made. The Owner is never
/// recorded: the Owner has no daily limit.
///
/// `amountKobo` is the amount counted (positive: a refund counts by its
/// size); `action` is the command (`waste.approve`) and `ref` the record's
/// human reference. **Append-only**, by trigger as `AuditLog` is: a ledger
/// row deleted is a manager's limit quietly raised. Restrict: a manager with
/// approvals is never deleted (staff are deactivated).
model ApprovalLedger {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  businessDate DateTime @db.Date
  staffId      String
  amountKobo   Int
  action       String
  ref          String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([staffId, businessDate])
}

// ============================== AUDIT, MESSAGES, ENQUIRIES (§4.8) ===========

/// The activity history: one row per command, written by one service
/// (`AuditService.record(entry, tx)`) inside the command's own transaction
/// (A6, A13).
///
/// **Append-only, enforced by the database.** A trigger raises on every
/// UPDATE, DELETE and TRUNCATE of this table, so no code path, mistaken
/// migration script or console session can rewrite history; TAY enforces the
/// same rule by convention only (D47). There is no `updatedAt`, because a
/// row never changes. `at` is the row's creation time.
///
/// The actor: `actorKind` says which of `staffId` and `customerId` is set (a
/// CHECK requires the matching id), and `actorName` and `actorRole` are
/// snapshots, so the entry reads the same after a rename. Both relations
/// restrict: an entry without its actor is not an entry.
///
/// `before` and `after` are kept for the server's plain-sentence port of
/// `describeChange`; **no API response returns them raw** (A13), and they
/// never hold a password hash, a QR token or a token of any kind.
model AuditLog {
  id String   @id @default(cuid())
  at DateTime @default(now())

  actorKind  AuditActorKind
  staffId    String?
  customerId String?
  actorName  String
  actorRole  String?
  /// The command name, e.g. `order.settle`.
  action     String
  module     String
  ref        String?
  before     Json?
  after      Json?
  reason     String?
  channel    String?
  ipAddress  String?

  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([at])
  @@index([ref])
  @@index([staffId, at])
  @@index([module, action, at])
}

/// A customer's in-app notification list. Written by the same events that
/// send email; reads are tracked by `Customer.notificationsReadAt`.
/// `dedupeKey` makes each event write at most one row however often it is
/// processed. Cascade: a notification is meaningless without its customer.
model CustomerNotification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  customerId String
  kind       CustomerNotificationKind
  title      String
  body       String
  link       String?
  dedupeKey  String                   @unique

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

/// An email or SMS waiting to go, sent after the command commits: a failed
/// send never rolls a command back (plan §4.8). `dedupeKey` makes each event
/// enqueue at most one message. The retry sweep (C6-8) re-sends `PENDING`
/// and `FAILED` rows up to three attempts.
///
/// `lastError` is the provider's reason, never the message body or subject.
model OutboundMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel   ContactChannel
  to        String
  template  String
  dedupeKey String                @unique
  status    OutboundMessageStatus @default(PENDING)
  attempts  Int                   @default(0)
  sentAt    DateTime?
  lastError String?

  @@index([status, createdAt])
}

/// A contact-form message or a large-group booking enquiry (D50). Stored,
/// then emailed to CNC. `ipHash` is a SHA-256 of the caller's address, for
/// rate limiting and abuse review without keeping the address itself.
/// `guests` is the form's text ("4+ guests"), not a number.
model Enquiry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kind          EnquiryKind
  name          String
  email         String?
  phone         String?
  subject       String?
  message       String
  venueId       String?
  requestedDate DateTime?     @db.Date
  guests        String?
  status        EnquiryStatus @default(NEW)
  ipHash        String?

  venue Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// A stored response for an `Idempotency-Key` (A9).
///
/// `IdempotencyService` inserts the row **inside the command's own
/// transaction, before the command runs**, and fills in the response before
/// it commits. So the key and the command commit together or not at all: a
/// refused or failed command leaves no row and may be retried with the same
/// key, and a duplicate arriving while the first is still running waits on
/// the unique index and then replays its response.
///
/// `scope` is `staff:<id>`, `customer:<id>` or `anon:<ip-hash>`, so one
/// caller's key never replays another caller's response. `requestHash` is the
/// SHA-256 of the request's route parameters, query and body: the same key
/// with a different request is a 409, never a replay of the wrong answer.
/// Rows older than 7 days are deleted by the tokens sweep.
model IdempotencyKey {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  scope          String
  key            String
  route          String
  requestHash    String
  responseStatus Int?
  responseBody   Json?

  @@unique([scope, key])
  @@index([createdAt])
}
